
/* =========================================================
   DICOSECO - STYLES.CSS
   Diseño y Remodelación de Interiores
   ========================================================= */

/* =========================
   VARIABLES
   ========================= */

:root {
    --color-principal: #1c1c1c;
    --color-secundario: #2b2b2b;
    --color-acento: #c49a5a;
    --color-acento-claro: #d8b477;

    --color-blanco: #ffffff;
    --color-crema: #f7f4ef;
    --color-gris-claro: #eeeeee;
    --color-gris: #777777;
    --color-texto: #333333;

    --sombra-suave: 0 10px 30px rgba(0, 0, 0, 0.08);
    --sombra-fuerte: 0 15px 40px rgba(0, 0, 0, 0.18);

    --radio: 10px;
    --transicion: 0.3s ease;

    --ancho-maximo: 1200px;
}


/* =========================
   RESET
   ========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: var(--color-blanco);
    color: var(--color-texto);
    line-height: 1.6;
}

img {
    display: block;
    width: 100%;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
textarea,
select {
    font-family: inherit;
}


/* =========================
   CONTENEDOR GENERAL
   ========================= */

.contenedor {
    width: 90%;
    max-width: var(--ancho-maximo);
    margin: 0 auto;
}


/* =========================
   HEADER
   ========================= */

.header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 78px;

    display: flex;
    align-items: center;

    background: rgba(28, 28, 28, 0.96);
    backdrop-filter: blur(10px);

    z-index: 1000;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.header_contenido {
    width: 90%;
    max-width: var(--ancho-maximo);
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}


/* =========================
   LOGO
   ========================= */

.header_logo a {
    color: var(--color-blanco);

    font-size: 27px;
    font-weight: 800;
    letter-spacing: 3px;

    transition: var(--transicion);
}

.header_logo a:hover {
    color: var(--color-acento);
}


/* =========================
   NAVEGACIÓN
   ========================= */

.nav_lista {
    display: flex;
    align-items: center;
    gap: 30px;

    list-style: none;
}

.nav_enlace {
    position: relative;

    color: var(--color-blanco);

    font-size: 14px;
    font-weight: 600;

    transition: var(--transicion);
}

.nav_enlace::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -8px;

    width: 0;
    height: 2px;

    background-color: var(--color-acento);

    transition: width var(--transicion);
}

.nav_enlace:hover {
    color: var(--color-acento);
}

.nav_enlace:hover::after {
    width: 100%;
}


/* =========================
   HERO / INICIO
   ========================= */

.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;

    position: relative;

    padding: 120px 5% 80px;

    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.82),
            rgba(0, 0, 0, 0.52),
            rgba(0, 0, 0, 0.25)
        ),
        url("../img/cocina-1.jpg") center / cover no-repeat;

    color: var(--color-blanco);
}

.hero_contenido {
    width: 90%;
    max-width: 750px;
    margin: 0 auto 0 5%;
}

.hero_etiqueta {
    color: var(--color-acento-claro);

    font-size: 13px;
    font-weight: 700;

    letter-spacing: 3px;

    margin-bottom: 22px;
}

.hero_titulo {
    font-size: clamp(42px, 6vw, 76px);

    line-height: 1.05;
    font-weight: 800;

    margin-bottom: 25px;
}

.hero_descripcion {
    max-width: 620px;

    color: rgba(255, 255, 255, 0.86);

    font-size: 18px;

    margin-bottom: 35px;
}


/* =========================
   BOTONES
   ========================= */

.hero_botones {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 52px;

    padding: 0 28px;

    border-radius: 4px;

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    transition:
        transform var(--transicion),
        background var(--transicion),
        color var(--transicion),
        box-shadow var(--transicion);
}

.boton:hover {
    transform: translateY(-3px);
}

.boton_principal {
    background-color: var(--color-acento);
    color: var(--color-blanco);

    border: 2px solid var(--color-acento);
}

.boton_principal:hover {
    background-color: var(--color-acento-claro);
    border-color: var(--color-acento-claro);

    box-shadow: 0 10px 25px rgba(196, 154, 90, 0.3);
}

.boton_secundario {
    background-color: transparent;

    color: var(--color-blanco);

    border: 2px solid rgba(255, 255, 255, 0.8);
}

.boton_secundario:hover {
    background-color: var(--color-blanco);
    color: var(--color-principal);
}


/* =========================
   SECCIONES GENERALES
   ========================= */

.seccion {
    padding: 110px 0;
}

.encabezado_seccion {
    max-width: 700px;

    margin: 0 auto 60px;

    text-align: center;
}

.etiqueta_seccion {
    color: var(--color-acento);

    font-size: 12px;
    font-weight: 800;

    letter-spacing: 3px;

    margin-bottom: 12px;
}

.titulo_seccion {
    color: var(--color-principal);

    font-size: clamp(32px, 4vw, 48px);

    line-height: 1.15;

    margin-bottom: 18px;
}

.parrafo_seccion {
    color: var(--color-gris);

    font-size: 16px;
}


/* =========================
   SERVICIOS
   ========================= */

.servicios {
    background-color: var(--color-crema);
}

.servicios_grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.tarjeta_servicio {
    background-color: var(--color-blanco);

    padding: 35px 30px;

    border-radius: var(--radio);

    box-shadow: var(--sombra-suave);

    border: 1px solid rgba(0, 0, 0, 0.05);

    transition:
        transform var(--transicion),
        box-shadow var(--transicion),
        border-color var(--transicion);
}

.tarjeta_servicio:hover {
    transform: translateY(-10px);

    box-shadow: var(--sombra-fuerte);

    border-color: rgba(196, 154, 90, 0.4);
}

.tarjeta_icono {
    width: 65px;
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: rgba(196, 154, 90, 0.12);

    border-radius: 50%;

    font-size: 28px;

    margin-bottom: 25px;
}

.tarjeta_titulo {
    color: var(--color-principal);

    font-size: 21px;

    margin-bottom: 12px;
}

.tarjeta_descripcion {
    color: var(--color-gris);

    font-size: 15px;

    line-height: 1.7;
}


/* =========================
   GALERÍA
   ========================= */

.galeria {
    background-color: var(--color-blanco);
}

.galeria_grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;
}

.galeria_item {
    position: relative;

    height: 300px;

    overflow: hidden;

    border-radius: var(--radio);

    background-color: var(--color-gris-claro);
}

.galeria_item img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform 0.6s ease,
        filter 0.6s ease;
}

.galeria_item::after {
    content: "";

    position: absolute;

    inset: 0;

    background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.4),
        transparent 60%
    );

    opacity: 0;

    transition: opacity var(--transicion);
}

.galeria_item:hover img {
    transform: scale(1.08);
    filter: brightness(0.85);
}

.galeria_item:hover::after {
    opacity: 1;
}


/* =========================
   NOSOTROS
   ========================= */

.nosotros {
    background-color: var(--color-crema);
}

.nosotros_contenido {
    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: center;

    gap: 70px;
}

.nosotros_imagen {
    overflow: hidden;

    border-radius: var(--radio);

    box-shadow: var(--sombra-fuerte);
}

.nosotros_imagen img {
    height: 560px;

    object-fit: cover;

    transition: transform 0.6s ease;
}

.nosotros_imagen:hover img {
    transform: scale(1.04);
}

.nosotros_texto .titulo_seccion {
    margin-bottom: 25px;
}

.parrafo {
    color: var(--color-gris);

    margin-bottom: 18px;

    line-height: 1.8;
}

.nosotros_beneficios {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 12px;

    margin-top: 30px;
}

.nosotros_beneficios p {
    color: var(--color-principal);

    font-size: 14px;
    font-weight: 600;
}

.nosotros_beneficios p::first-letter {
    color: var(--color-acento);
}


/* =========================
   PROYECTOS
   ========================= */

.proyectos {
    background-color: var(--color-blanco);
}

.proyectos_grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.tarjeta_proyecto {
    overflow: hidden;

    background-color: var(--color-blanco);

    border-radius: var(--radio);

    box-shadow: var(--sombra-suave);

    transition:
        transform var(--transicion),
        box-shadow var(--transicion);
}

.tarjeta_proyecto:hover {
    transform: translateY(-8px);

    box-shadow: var(--sombra-fuerte);
}

.proyecto_imagen {
    height: 280px;

    overflow: hidden;
}

.proyecto_imagen img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.6s ease;
}

.tarjeta_proyecto:hover .proyecto_imagen img {
    transform: scale(1.08);
}

.proyecto_contenido {
    padding: 25px;
}

.proyecto_categoria {
    display: inline-block;

    color: var(--color-acento);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 10px;
}

.proyecto_contenido h3 {
    color: var(--color-principal);

    font-size: 22px;

    margin-bottom: 10px;
}

.proyecto_contenido p {
    color: var(--color-gris);

    font-size: 14px;
}


/* =========================
   CONTACTO
   ========================= */

.contacto {
    background-color: var(--color-principal);

    color: var(--color-blanco);
}

.contacto .titulo_seccion {
    color: var(--color-blanco);
}

.contacto .parrafo_seccion {
    color: rgba(255, 255, 255, 0.65);
}

.contacto_contenido {
    display: grid;

    grid-template-columns: 0.8fr 1.2fr;

    gap: 60px;

    align-items: start;
}

.contacto_info {
    padding: 20px 0;
}

.contacto_info h3 {
    color: var(--color-blanco);

    font-size: 30px;

    margin-bottom: 15px;
}

.contacto_info > p {
    color: rgba(255, 255, 255, 0.7);

    margin-bottom: 35px;
}

.dato_contacto {
    padding: 20px 0;

    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.dato_contacto strong {
    display: block;

    color: var(--color-acento-claro);

    font-size: 14px;

    margin-bottom: 5px;
}

.dato_contacto p {
    color: var(--color-blanco);

    font-size: 15px;
}


/* =========================
   FORMULARIO
   ========================= */

.formulario {
    padding: 40px;

    background-color: var(--color-blanco);

    border-radius: var(--radio);

    box-shadow: var(--sombra-fuerte);
}

.campo {
    margin-bottom: 22px;
}

.campo label {
    display: block;

    color: var(--color-principal);

    font-size: 13px;
    font-weight: 700;

    margin-bottom: 8px;
}

.campo input,
.campo select,
.campo textarea {
    width: 100%;

    padding: 14px 15px;

    border: 1px solid #dddddd;

    border-radius: 5px;

    background-color: #fafafa;

    color: var(--color-texto);

    font-size: 14px;

    outline: none;

    transition:
        border-color var(--transicion),
        box-shadow var(--transicion),
        background-color var(--transicion);
}

.campo input:focus,
.campo select:focus,
.campo textarea:focus {
    border-color: var(--color-acento);

    background-color: var(--color-blanco);

    box-shadow: 0 0 0 3px rgba(196, 154, 90, 0.12);
}

.campo textarea {
    min-height: 140px;

    resize: vertical;
}

.formulario .boton {
    width: 100%;

    border: none;

    margin-top: 5px;
}


/* =========================
   FOOTER
   ========================= */

.footer {
    background-color: #111111;

    color: var(--color-blanco);

    padding: 55px 0 30px;
}

.footer_contenido {
    width: 90%;
    max-width: var(--ancho-maximo);

    margin: 0 auto;

    text-align: center;
}

.footer_logo {
    color: var(--color-blanco);

    font-size: 27px;
    font-weight: 800;

    letter-spacing: 3px;

    margin-bottom: 10px;
}

.footer_contenido > p {
    color: rgba(255, 255, 255, 0.55);

    font-size: 14px;
}

.footer_enlaces {
    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 25px;

    margin: 30px 0;
}

.footer_enlaces a {
    color: rgba(255, 255, 255, 0.7);

    font-size: 13px;

    transition: color var(--transicion);
}

.footer_enlaces a:hover {
    color: var(--color-acento);
}

.footer_copy {
    padding-top: 25px;

    border-top: 1px solid rgba(255, 255, 255, 0.08);

    font-size: 12px !important;
}


/* =========================
   ANIMACIONES
   ========================= */

@keyframes aparecer {

    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero_contenido {
    animation: aparecer 1s ease forwards;
}


/* =========================
   EFECTO SELECCIÓN
   ========================= */

::selection {
    background-color: var(--color-acento);

    color: var(--color-blanco);
}


/* =========================
   SCROLLBAR
   ========================= */

::-webkit-scrollbar {
    width: 9px;
}

::-webkit-scrollbar-track {
    background-color: #eeeeee;
}

::-webkit-scrollbar-thumb {
    background-color: var(--color-acento);

    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background-color: #a77d40;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1000px) {

    .nav_lista {
        gap: 18px;
    }

    .nav_enlace {
        font-size: 13px;
    }

    .servicios_grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .galeria_grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .proyectos_grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .nosotros_contenido {
        gap: 40px;
    }

    .contacto_contenido {
        gap: 35px;
    }
}


/* =========================================================
   CELULAR
   ========================================================= */

@media (max-width: 768px) {

    .header {
        height: auto;

        padding: 18px 0;
    }

    .header_contenido {
        flex-direction: column;

        gap: 15px;
    }

    .nav_lista {
        flex-wrap: wrap;

        justify-content: center;

        gap: 15px;
    }

    .hero {
        min-height: 100vh;

        padding-top: 160px;
    }

    .hero_contenido {
        width: 100%;

        margin: 0 auto;
    }

    .hero_titulo {
        font-size: 43px;
    }

    .hero_descripcion {
        font-size: 16px;
    }

    .hero_botones {
        flex-direction: column;

        align-items: stretch;
    }

    .boton {
        width: 100%;
    }

    .seccion {
        padding: 75px 0;
    }

    .encabezado_seccion {
        margin-bottom: 40px;
    }

    .servicios_grid,
    .galeria_grid,
    .proyectos_grid {
        grid-template-columns: 1fr;
    }

    .galeria_item {
        height: 280px;
    }

    .nosotros_contenido {
        grid-template-columns: 1fr;

        gap: 40px;
    }

    .nosotros_imagen img {
        height: 400px;
    }

    .nosotros_beneficios {
        grid-template-columns: 1fr;
    }

    .contacto_contenido {
        grid-template-columns: 1fr;

        gap: 30px;
    }

    .formulario {
        padding: 25px;
    }
}


/* =========================================================
   CELULARES PEQUEÑOS
   ========================================================= */

@media (max-width: 480px) {

    .header_logo a {
        font-size: 23px;
    }

    .nav_lista {
        gap: 10px 14px;
    }

    .nav_enlace {
        font-size: 12px;
    }

    .hero {
        padding-left: 20px;
        padding-right: 20px;
    }

    .hero_titulo {
        font-size: 36px;
    }

    .hero_etiqueta {
        font-size: 10px;

        letter-spacing: 2px;
    }

    .titulo_seccion {
        font-size: 32px;
    }

    .tarjeta_servicio {
        padding: 28px 22px;
    }

    .formulario {
        padding: 20px;
    }

    .contacto_info h3 {
        font-size: 25px;
    }

    .footer_enlaces {
        gap: 15px;
    }
}
